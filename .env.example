# ─── Configuração do Servidor MCP Resolutivo.AI ─────────────────────────────

# Modo de execução e rede
HOST=0.0.0.0
PORT=8000
SERVER_BASE_URL=http://localhost:8000

# Modo de Autenticação:
# - "none": Sem autenticação (ideal para desenvolvimento local e MCP Inspector)
# - "bearer": Exige header 'Authorization: Bearer <MCP_API_KEY>'
# - "oauth": Autenticação completa OAuth 2.1 (para Gemini Connected App / Produção)
AUTH_MODE=none

# Chave de API estática (usada se AUTH_MODE=bearer)
MCP_API_KEY=sua-chave-secreta-mcp-aqui

# Configurações OAuth 2.1 (usadas se AUTH_MODE=oauth para Gemini Connected App)
OAUTH_CLIENT_ID=gemini-mcp-client
OAUTH_CLIENT_SECRET=gerar-segredo-forte-em-producao
JWT_SECRET=gerar-chave-jwt-secreta-forte-em-producao

# Chaves de APIs Externas (opcionais / públicas)
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# NotebookLM (Opcional - caminho para CLI ou endpoint local)
NOTEBOOKLM_MCP_PATH=
